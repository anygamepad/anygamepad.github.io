{
  "$id": "https://anygamepad.github.io/schema/profile.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile",
  "description": "A device profile.\n\nSee `data/profiles/README.md` for the file format.",
  "type": "object",
  "properties": {
    "attribution": {
      "description": "Origin and license notice of imported data (required for SDL\nGameControllerDB entries).",
      "type": [
        "string",
        "null"
      ]
    },
    "face": {
      "description": "Labels printed on the face buttons; the family's when not set.",
      "anyOf": [
        {
          "$ref": "#/$defs/FaceLayout"
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "description": "Device family, when known.",
      "anyOf": [
        {
          "$ref": "#/$defs/Family"
        },
        {
          "type": "null"
        }
      ]
    },
    "indices": {
      "description": "What input indices count.",
      "$ref": "#/$defs/Indices"
    },
    "mapping": {
      "description": "Mapping entries; those whose `when` holds apply in order, and later\nentries replace the targets they set.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mapping"
      }
    },
    "match": {
      "description": "The devices this profile is for: any rule may hold.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MatchRule"
      }
    },
    "name": {
      "description": "Human-readable name of the device or class of devices.",
      "type": "string"
    },
    "schema_version": {
      "description": "Format version: [`SCHEMA_VERSION`].",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "source": {
      "description": "Where the profile comes from.",
      "$ref": "#/$defs/ProfileSource"
    },
    "verified": {
      "description": "Whether the mapping was checked on real hardware.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "source",
    "verified",
    "match"
  ],
  "$defs": {
    "Axis": {
      "type": "string",
      "enum": [
        "left_stick_x",
        "left_stick_y",
        "right_stick_x",
        "right_stick_y",
        "left_trigger",
        "right_trigger"
      ]
    },
    "AxisMapping": {
      "description": "How a canonical axis is driven: an input over the whole axis, or a table with either `input` or the halves (`negative`, `positive`), and an optional `deadzone`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Input"
        },
        {
          "type": "object",
          "properties": {
            "deadzone": {
              "type": "number",
              "exclusiveMaximum": 1,
              "minimum": 0
            },
            "input": {
              "$ref": "#/$defs/Input"
            },
            "negative": {
              "$ref": "#/$defs/Input"
            },
            "positive": {
              "$ref": "#/$defs/Input"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "negative"
                    ]
                  },
                  {
                    "required": [
                      "positive"
                    ]
                  }
                ]
              },
              "required": [
                "input"
              ]
            },
            {
              "allOf": [
                {
                  "anyOf": [
                    {
                      "required": [
                        "negative"
                      ]
                    },
                    {
                      "required": [
                        "positive"
                      ]
                    }
                  ]
                },
                {
                  "not": {
                    "required": [
                      "input"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "Backend": {
      "type": "string",
      "enum": [
        "unknown",
        "evdev",
        "hidraw",
        "windows_hid",
        "xinput",
        "windows_gaming_input",
        "game_input",
        "direct_input",
        "iokit_hid",
        "game_controller",
        "gamepad_api",
        "webhid"
      ]
    },
    "BrowserEngine": {
      "type": "string",
      "enum": [
        "unknown",
        "blink",
        "gecko",
        "webkit"
      ]
    },
    "Button": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "south",
            "east",
            "west",
            "north",
            "dpad_up",
            "dpad_down",
            "dpad_left",
            "dpad_right",
            "left_shoulder",
            "right_shoulder",
            "left_trigger",
            "right_trigger",
            "left_stick",
            "right_stick",
            "select",
            "start",
            "home",
            "share",
            "capture",
            "mute",
            "left_paddle_1",
            "left_paddle_2",
            "right_paddle_1",
            "right_paddle_2",
            "touchpad_click"
          ]
        },
        {
          "pattern": "^extra_([0-9]|[12][0-9]|3[01])$"
        }
      ]
    },
    "ButtonLabel": {
      "type": "string",
      "enum": [
        "unknown",
        "a",
        "b",
        "x",
        "y",
        "cross",
        "circle",
        "square",
        "triangle"
      ]
    },
    "DescriptorHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16}$"
    },
    "FaceLayout": {
      "description": "Labels printed on the four face buttons of a device.\n\nGame logic uses positions ([`Button::South`], ...); prompts use\n[`FaceLayout::label`]. The layout of each device comes from its profile, so\na new family with known labels needs no code change.",
      "type": "object",
      "properties": {
        "east": {
          "description": "Label of [`Button::East`].",
          "$ref": "#/$defs/ButtonLabel"
        },
        "north": {
          "description": "Label of [`Button::North`].",
          "$ref": "#/$defs/ButtonLabel"
        },
        "south": {
          "description": "Label of [`Button::South`].",
          "$ref": "#/$defs/ButtonLabel"
        },
        "west": {
          "description": "Label of [`Button::West`].",
          "$ref": "#/$defs/ButtonLabel"
        }
      },
      "required": [
        "south",
        "east",
        "west",
        "north"
      ]
    },
    "Family": {
      "type": "string",
      "enum": [
        "dualshock3",
        "dualshock4",
        "dualsense",
        "dualsense_edge",
        "switch_pro",
        "xbox"
      ]
    },
    "Indices": {
      "description": "What the indices of a profile's inputs (`b3`, `a1`, `h0`) count.",
      "oneOf": [
        {
          "description": "Positions in the list of the backend the profile matches (Gamepad API\n`buttons` and `axes`, DirectInput objects, ...).",
          "type": "string",
          "const": "backend"
        },
        {
          "description": "SDL's joystick indices on the SDL backend named by the match rule's\n`sdl_guid` (its driver signature) for the rule's `os`, as in SDL\nGameControllerDB. Only providers that reproduce SDL's order can apply\nsuch a profile.",
          "type": "string",
          "const": "sdl"
        }
      ]
    },
    "Input": {
      "description": "A raw element: `b<ref>` (button), `a<ref>` (axis), `+a<ref>`/`-a<ref>` (half axis), optionally ending in `~` (reversed), or `h<ref>.<mask>` (hat directions: 1 up, 2 right, 4 down, 8 left). <ref> is a decimal index or a raw source in braces: `{evdev:0x0130}`, `{hid:0x0001:0x0030}`, `{button:south}`, `{axis:left_stick_x}`.",
      "type": "string",
      "pattern": "^(b(0|[1-9][0-9]*|\\{evdev:0x[0-9a-fA-F]{1,4}\\}|\\{hid:0x[0-9a-fA-F]{1,4}:0x[0-9a-fA-F]{1,4}\\}|\\{button:[a-z0-9_]+\\}|\\{axis:[a-z_]+\\})|[+-]?a(0|[1-9][0-9]*|\\{evdev:0x[0-9a-fA-F]{1,4}\\}|\\{hid:0x[0-9a-fA-F]{1,4}:0x[0-9a-fA-F]{1,4}\\}|\\{button:[a-z0-9_]+\\}|\\{axis:[a-z_]+\\})~?|h(0|[1-9][0-9]*|\\{evdev:0x[0-9a-fA-F]{1,4}\\}|\\{hid:0x[0-9a-fA-F]{1,4}:0x[0-9a-fA-F]{1,4}\\}|\\{button:[a-z0-9_]+\\}|\\{axis:[a-z_]+\\})\\.([1-9]|1[0-5]))$"
    },
    "Mapping": {
      "description": "One entry of a profile's mapping: canonical targets and the raw inputs\nthat drive them, for the devices that meet `when`.\n\nA target reads its input's position `t` in `[0, 1]` (see [`Input`]):\n\n- a **button** is pressed while `t` is at least 0.5; a `b` input presses\n  it while the raw button reads as pressed (the provider's threshold for\n  analog buttons);\n- a **stick axis** is `2t - 1` (from -1 to 1), a **trigger axis** is `t`;\n- a `negative` half is `-t`, a `positive` half is `t`.\n\nInactive inputs (the other half of a half axis) leave their target at\nrest. Stick Y axes are positive **up** (ADR 0001): most backends report\nthem positive down, so their inputs end in `~`.",
      "type": "object",
      "properties": {
        "axes": {
          "description": "Canonical axes and their inputs.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AxisMapping"
          },
          "propertyNames": {
            "$ref": "#/$defs/Axis"
          }
        },
        "buttons": {
          "description": "Canonical buttons and their inputs.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "propertyNames": {
            "$ref": "#/$defs/Button"
          }
        },
        "when": {
          "description": "Devices this entry applies to; empty for all the profile matches.",
          "$ref": "#/$defs/MatchRule"
        }
      },
      "additionalProperties": false
    },
    "MatchRule": {
      "description": "Conditions on a [`DeviceIdentity`]; every field that is set must hold.\n\nUsed both to select profiles (`[[match]]`) and to restrict mapping\nentries (`when`).",
      "type": "object",
      "properties": {
        "backend": {
          "description": "API the device is read through.",
          "anyOf": [
            {
              "$ref": "#/$defs/Backend"
            },
            {
              "type": "null"
            }
          ]
        },
        "browser": {
          "description": "Browser engine, for web backends.",
          "anyOf": [
            {
              "$ref": "#/$defs/BrowserEngine"
            },
            {
              "type": "null"
            }
          ]
        },
        "descriptor_hash": {
          "description": "Hash of the HID report descriptor.",
          "anyOf": [
            {
              "$ref": "#/$defs/DescriptorHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "driver": {
          "description": "OS driver that owns the device (`xpad`, `hid-playstation`, ...).",
          "type": [
            "string",
            "null"
          ]
        },
        "gamepad_mapping": {
          "description": "`Gamepad.mapping` (`\"standard\"`, `\"\"`), for the Gamepad API.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Product name, exactly as the backend reports it.",
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "description": "Host OS.",
          "anyOf": [
            {
              "$ref": "#/$defs/Os"
            },
            {
              "type": "null"
            }
          ]
        },
        "product_id": {
          "description": "Product ID; needs `vendor_id`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sdl_guid": {
          "description": "SDL joystick GUID. Compared without its name CRC, and without the\nversion when the GUID's version is 0, as SDL does; the device's GUID\nis computed with this GUID's driver signature.",
          "anyOf": [
            {
              "$ref": "#/$defs/SdlGuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "transport": {
          "description": "How the device is connected.",
          "anyOf": [
            {
              "$ref": "#/$defs/Transport"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor_id": {
          "description": "USB/Bluetooth vendor ID.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "version": {
          "description": "Version (`bcdDevice`, HID or evdev version).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Os": {
      "type": "string",
      "enum": [
        "unknown",
        "linux",
        "windows",
        "macos",
        "android",
        "ios"
      ]
    },
    "ProfileSource": {
      "description": "Where a profile comes from.",
      "oneOf": [
        {
          "description": "Written by hand in `data/profiles/`.",
          "type": "string",
          "const": "curated"
        },
        {
          "description": "Imported from SDL GameControllerDB ([`crate::sdl`]).",
          "type": "string",
          "const": "sdl-gamecontrollerdb"
        },
        {
          "description": "Generated from device reports collected by the testers (P4).",
          "type": "string",
          "const": "report"
        }
      ]
    },
    "SdlGuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "Transport": {
      "type": "string",
      "enum": [
        "unknown",
        "usb",
        "bluetooth",
        "bluetooth_le",
        "dongle"
      ]
    }
  }
}
